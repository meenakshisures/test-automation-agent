# Copy to .env and fill in. .env is gitignored - never commit real credentials.
BASE_URL=https://your-app.example.com
APP=meiden

# Test account (Microsoft Entra ID / Azure AD SSO)
TEST_USERNAME=
TEST_PASSWORD=

# MFA (only needed if the account is prompted). Pick one:
#  1) TOTP: base32 secret from the Authenticator setup screen (choose "enter key manually") - codes are generated automatically
#  2) Leave blank and run headed (npm run test:headed): login pauses so you can approve the push / type the code yourself
MFA_TOTP_SECRET=
MFA_WAIT_MS=120000
