{
  "app": "meiden",
  "baseURL": "https://icy-ground-0316a2b0f.2.azurestaticapps.net",
  "_comment": "Layer 3 output: grounded from the live accessibility tree (authenticated via Microsoft SSO). The app has no data-test attributes, so locators use ARIA role + accessible name.",
  "auth": "Microsoft Entra ID SSO; handled by auth/microsoft-login.ts and the 'setup' Playwright project (supports TOTP MFA).",
  "pages": {
    "login": {
      "url": "/login",
      "elements": {
        "heading": "role=heading[name='Welcome Back']",
        "signInWithMicrosoft": "role=button[name='Sign in with Microsoft']"
      }
    },
    "dashboard": {
      "url": "/dashboard",
      "elements": {
        "heading": "role=heading[name='Dashboard', level=1]",
        "analytics": "role=heading[name='Operational Analytics']",
        "nav": "role=navigation"
      }
    },
    "productionOrders": {
      "url": "/productionOrders",
      "elements": {
        "heading": "role=heading[name='All Production Orders']",
        "search": "role=textbox[name='Search orders']",
        "filter": "role=button[name='Filter']",
        "createNewOrder": "role=button[name='Create New Order']",
        "table": "role=table"
      }
    },
    "lookup": {
      "url": "/lookup",
      "elements": {
        "heading": "role=heading[name='Look Up Criteria']",
        "byOrder": "role=radio[name='Look Up by Production Order #']",
        "byPurchaseOrder": "role=radio[name='Look Up by Purchase Order']",
        "byCustomer": "role=radio[name='Look Up by Customer Name']",
        "orderInput": "role=textbox[name=/Enter 7-digit production order number/]",
        "lookUp": "role=button[name='Look Up']"
      }
    },
    "settings": {
      "url": "/settings",
      "elements": {
        "heading": "role=heading[name='Settings']",
        "usersHeading": "role=heading[name='Users']",
        "searchUsers": "role=textbox[name='Search users']",
        "addNewUser": "role=button[name='Add New User']"
      }
    }
  }
}
