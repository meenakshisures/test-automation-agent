{
  "name": "test-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-driven Playwright test-automation agent (POC): prompt/CSV -> IR -> grounded specs -> run -> report.",
  "scripts": {
    "parse": "node scripts/parse.mjs",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "report": "node scripts/report.mjs",
    "report:open": "playwright show-report reports/html",
    "agent": "node scripts/run.mjs",
    "install:browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^26.6.6",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "pdf-parse": "^1.1.1"
  }
}
