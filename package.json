{
  "name": "test-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI test-automation agent (POC): CSV/prompt test cases -> IR -> Playwright TypeScript scripts -> static validation -> report.",
  "scripts": {
    "parse": "node scripts/parse.mjs",
    "validate": "node scripts/validate.mjs",
    "report": "node scripts/report.mjs",
    "agent": "node scripts/run.mjs",
    "test": "playwright test",
    "test:list": "playwright test --list"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^26.6.6",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "pdf-parse": "^1.1.1"
  }
}
